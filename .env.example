# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=sk-ant-...

# Search provider (needed for the research agent): https://dashboard.exa.ai
EXA_API_KEY=

# Database (default: local SQLite file dev.db). Production: Supabase Postgres.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# Local Postgres from `docker compose up -d postgres redis`:
# DATABASE_URL=postgresql+asyncpg://postgres:outreach@localhost:5432/outreach

# Job queue (default: local Redis)
# REDIS_URL=redis://localhost:6379

# Tracing (optional): https://logfire.pydantic.dev — unset means nothing is sent
# LOGFIRE_TOKEN=

# Public demo guards (0 disables one). Costs are our estimates from token counts.
# DEMO_RUNS_PER_CLIENT_PER_HOUR=3
# DEMO_DAILY_SPEND_USD=2.0
# DEMO_RESERVE_PER_RUN_USD=0.50

# Optional overrides (defaults live in app/config.py)
# MODEL_SMART=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-4-5-20251001
# RESEARCH_MAX_TURNS=10
# RESEARCH_MAX_TOKENS=150000
